# T-AV0, Step 4.5. Template for .env.av.local — the ONLY env file this
# worktree's dev server, seed script and guard read.
#
# Copy it and fill in the local stack's keys:
#   cp .env.av.example .env.av.local
#   npm run db:start          # prints the keys, or run `supabase status`
#
# .env.av.local is gitignored (`.env*.local`). This template is committed so a
# fresh clone is not a guessing game, and av-guard deliberately does NOT read
# it — a guard that falls back to a tidy committed template would report
# `db=local` for a shell whose app is talking to production.
#
# EVERY VALUE HERE IS A LOCAL-STACK VALUE. The service-role key printed by
# `supabase status` is not a secret and is not production's; it is the same on
# every machine running the CLI.

# ── which database ─────────────────────────────────────────────────────────
# Must be localhost or 127.0.0.1. av-guard fails a db:* or seed script when it
# is not, and scripts/av-seed-local.mjs refuses to run at all.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status: anon key>
SUPABASE_SERVICE_ROLE_KEY=<supabase status: service_role key>

# ── the hard line, rule 4: no real outbound messages ───────────────────────
# Unset is NOT log. av-guard fails on an unset value on purpose, because an
# unset variable is exactly the shell in which a send path uses its own
# production default.
PUSH_MODE=log
EMAIL_MODE=log

# ── the hard line, rule 6: the runtime flag ────────────────────────────────
# all | allowlist | anything else (= off). Never NEXT_PUBLIC_: a client-side
# flag ships to the browser and can be edited there.
ATHLETE_VALUE_ENABLED=allowlist
# Comma-separated user uuids. The seeded local athlete Ana is the first one.
ATHLETE_VALUE_ALLOWLIST=00000000-0000-4000-8000-000000000001
# Optional. Unset means every T-AV feature; set means ONLY these, so adding it
# can only ever remove surfaces.
# ATHLETE_VALUE_FEATURES=pase

# ── everything else the app needs to boot ──────────────────────────────────
# Placeholders: none of these reach a real service in log mode.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_POSTHOG_KEY=placeholder
NEXT_PUBLIC_POSTHOG_HOST=https://placeholder.posthog.com
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=placeholder
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder
