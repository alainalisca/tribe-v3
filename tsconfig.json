{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // T-AV0: supabase/avMigrationCheck.ts is imported BOTH by vitest and by
    // scripts/av-migration-check.mjs running under node --experimental-strip-types,
    // and node ESM requires the explicit extension. Legal only with noEmit (set
    // above); it permits the spelling and changes nothing else.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "target": "ES2017"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "Feedback button document files", "supabase/functions", "e2e", "playwright.config.ts"]
}
