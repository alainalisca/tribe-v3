#!/usr/bin/env bash
set -euo pipefail

remote="$1"
url="$2"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "❌ BLOCKED: pushing to main is forbidden from the Tribe.OS worktree."
    echo "   T-OS0 HARD LINE rule 1: all work lives on tribe-os/* branches."
    exit 1
  fi
done

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)

if [ -n "$branch" ]; then
  case "$branch" in
    tribe-os/*|feat/t-os*)
      ;;
    *)
      echo "❌ BLOCKED: branch '$branch' does not start with tribe-os/ or feat/t-os."
      echo "   T-OS0 HARD LINE rule 1."
      exit 1
      ;;
  esac
fi

echo "🛡️  Running os:guard before push..."
node scripts/os-guard.mjs
